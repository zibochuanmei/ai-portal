# AI Portal 环境变量模板
# 请复制为 infra/.env 使用，infra/.env 不提交到 Git。

# 应用和制造业试点默认配置
# 以下是台北制衣业务试点的初始默认值；真实公司、工厂、部门和授权数据存放在 PostgreSQL。
APP_ENV=development
APP_NAME=ai-portal
APP_VERSION=0.1.0
DEPLOYMENT_MODE=local-compose
COMPOSE_PROJECT_NAME=ai-portal
DEFAULT_COMPANY_CODE=HZ
DEFAULT_REGION_CODE=TW
DEFAULT_FACTORY_CODE=TAIPEI
DEFAULT_TIMEZONE=Asia/Taipei
DEFAULT_LOCALE=zh-CN
SUPPORTED_REGION_CODES=TW
SUPPORTED_FACTORY_CODES=TAIPEI

# Portal 前端和后端网络配置
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
DATA_ROOT=../.data

# 身份认证配置：当前使用演示模式，IT 提供统一认证后切换为企业 OIDC
AUTH_MODE=demo
JWT_SECRET=change-this-in-infra-env
ACCESS_TOKEN_EXPIRE_MINUTES=60
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# PostgreSQL：保存用户、部门、权限、任务和业务元数据
POSTGRES_HOST=postgres
POSTGRES_DB=ai_portal
POSTGRES_USER=ai_portal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ai_portal:change-me@postgres:5432/ai_portal

# Redis：用于缓存和后续 Celery 异步任务队列
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO：业务文件和 Milvus 内部对象数据使用不同 Bucket 隔离
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUSINESS_BUCKET=ai-portal-business-dev
MINIO_VECTOR_BUCKET=ai-portal-milvus-dev

# Milvus Standalone 和 etcd：本地 Compose 中只通过 Docker 内部网络访问
ETCD_HOST=etcd
ETCD_PORT=2379
ETCD_ENDPOINTS=etcd:2379
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION_PREFIX=ai_portal_dev

# 制衣业务文件接收默认配置
# 预计处理采购 PI、报价单、发票、BOM、工艺单、质检记录、生产资料和工厂通知。
FILE_MAX_SIZE_MB=50
FILE_STORAGE_DIR=../.data/uploads
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,txt,jpg,jpeg,png
FILE_SCAN_REQUIRED=false
DOCUMENT_DEFAULT_CLASSIFICATION=internal
DOCUMENT_DEFAULT_DOMAIN=production
DOCUMENT_DEFAULT_FACTORY_CODE=TAIPEI
STORAGE_RAW_PREFIX=raw
STORAGE_PROCESSED_PREFIX=processed

# 日志和请求链路追踪配置
LOG_LEVEL=INFO
LOG_ROTATION_MB=20
LOG_BACKUP_COUNT=5
TRACE_HEADER=X-Request-ID

# Model Gateway 占位配置：IT 确认可以调用前，开发环境保持 API Key 为空。
# 后端必须通过 Model Gateway 调用模型，前端不能接触模型密钥。
MODEL_GATEWAY_DEFAULT_PROVIDER=mock
MODEL_GATEWAY_TIMEOUT_SECONDS=60
MODEL_GATEWAY_MAX_RETRIES=2
EXTERNAL_MODEL_ENABLED=false
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_MODEL=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=

# 未来 L20 GPU 服务器的本地模型占位配置
# 完成真实样本评测和数据审查前，不要选择生产模型。
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_DIR=/models
LOCAL_INTENT_MODEL=
LOCAL_EMBEDDING_MODEL=
LOCAL_RERANKER_MODEL=
GPU_ENABLED=false
GPU_DEVICE=0
